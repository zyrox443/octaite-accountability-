# Supabase > Project Settings > API
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" / "publishable" key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# "service_role" / "secret" key. SERVER ONLY. Never share it or prefix it with NEXT_PUBLIC_.
# Used only by the admin API routes that create and manage member accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
